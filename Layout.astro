---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Dennis Fields">
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <img src="/dennis-headshot.png" alt="Dennis Fields" class="rounded-2xl shadow-2xl">
        </div>
        <div>
          <h1 class="text-5xl font-bold text-gray-900 mb-6">Meet Dennis Fields</h1>
          <p class="text-xl text-gray-700 mb-6 leading-relaxed">
            I'm not your typical loan officer. I'm a deal rescuer, educator, and family advocate who's been helping people across NC, SC, and VA achieve homeownership for over 20 years.
          </p>
          <p class="text-lg text-gray-600 mb-6">
            What drives me? Turning "no" into "yes." I specialize in the cases other lenders won't touch—first-time buyers with limited savings, veterans navigating VA loans, families with credit challenges, and deals that are falling apart at the finish line.
          </p>
          <p class="text-lg text-gray-600 mb-6">
            When I'm not helping families get into homes, you'll find me on the mat training Brazilian jiu-jitsu, cheering for my beloved New York Jets, or spending time with my wife and two sons right here in Greensboro.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://calendly.com/dennisfieldsmortgagepro" target="_blank" class="inline-block bg-primary-magenta text-white px-6 py-3 rounded-lg font-bold text-center hover:bg-pink-600 transition-all">
              Schedule a Call
            </a>
            <a href="https://maps.app.goo.gl/zuYBrQ4WReoxDLSG7" target="_blank" class="inline-block bg-primary-cyan text-white px-6 py-3 rounded-lg font-bold text-center hover:bg-cyan-600 transition-all">
              Leave a Review
            </a>
          </div>
        </div>
      </div>

      <div class="bg-gray-50 rounded-2xl p-12 mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">My Philosophy</h2>
        <div class="prose prose-lg max-w-none text-gray-700">
          <p class="text-center mb-8 text-xl">
            "Homeownership isn't just about qualifying for a loan—it's about building a sustainable path to financial freedom for you and your family."
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-xl text-primary-magenta mb-3">Education First</h3>
              <p>I don't just push paperwork. I teach you how the process works, what your options are, and how to make smart decisions for your long-term success.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl text-primary-cyan mb-3">Speed + Strategy</h3>
              <p>In competitive markets, speed wins. My 14-30 day closings give you the edge while maintaining strategic guidance throughout.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl text-primary-magenta mb-3">Real Solutions</h3>
              <p>Been declined? Credit challenges? Limited savings? I find creative, compliant solutions that other lenders miss.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl text-primary-cyan mb-3">Community Focus</h3>
              <p>I'm invested in the Triad community—coaching youth sports, church involvement, and helping neighbors achieve their dreams.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Credentials & Experience</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <div class="bg-white p-6 rounded-xl shadow-md">
            <p class="text-4xl font-bold text-primary-magenta mb-2">20+</p>
            <p class="text-gray-600">Years in Mortgage Industry</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md">
            <p class="text-4xl font-bold text-primary-cyan mb-2">NMLS</p>
            <p class="text-gray-600">#1407951</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md">
            <p class="text-4xl font-bold text-primary-magenta mb-2">3 States</p>
            <p class="text-gray-600">NC, SC, VA Licensed</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
