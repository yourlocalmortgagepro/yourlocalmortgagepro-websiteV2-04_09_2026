<script>
  type Debt = { id: number; name: string; type: 'installment' | 'revolving'; balance: string; rate: string; payment: string; secured: boolean };
  type V = Record<string, string>;

  const MAX = 600;
  const defaults = () => ({ homeValue: '475000', mortgageBalance: '275000', mortgageRate: '4.25', mortgageMonths: '276', newRate: '6.5', newMonths: '360', closingCosts: '7500', ltvLimit: '80' });
  const blank = () => ({ homeValue: '', mortgageBalance: '', mortgageRate: '', mortgageMonths: '', newRate: '', newMonths: '', closingCosts: '', ltvLimit: '80' });
  const exampleDebts = (): Debt[] => [
    { id: 1, name: 'Auto loan', type: 'installment', balance: '18500', rate: '7.9', payment: '451', secured: false },
    { id: 2, name: 'Credit card', type: 'revolving', balance: '12000', rate: '22.9', payment: '400', secured: false },
    { id: 3, name: 'HELOC', type: 'revolving', balance: '30000', rate: '9.25', payment: '350', secured: true },
  ];

  const state = { v: defaults() as V, finance: true, debts: exampleDebts(), extra: null as string | null };

  const num = (x: unknown) => { const n = Number(x); return isFinite(n) && n > 0 ? n : 0; };
  const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const money = (n: number) => (isFinite(n) ? fmt.format(n) : '—');
  const pct = (n: number) => (isFinite(n) ? n.toFixed(2) + '%' : '—');
  const pmt = (b: number, rate: number, m: number) => {
    if (b <= 0 || m <= 0) return 0;
    const r = rate / 1200;
    return r === 0 ? b / m : (b * r) / (1 - Math.pow(1 + r, -m));
  };
  type Acct = { balance: unknown; rate: unknown; months?: unknown; payment?: unknown; byTerm?: boolean; secured?: boolean };
  function sim(a: Acct, extra = 0) {
    let b = num(a.balance);
    const rate = num(a.rate), r = rate / 1200;
    let sched = a.byTerm ? pmt(b, rate, Math.floor(num(a.months))) : num(a.payment);
    if (extra > 0 && sched > 0) sched += extra;
    const rows: { opening: number; paid: number; rate: number }[] = [];
    if (b <= 0) return { rows, totalInterest: 0, payoff: 0, valid: true, scheduled: 0 };
    if (sched <= 0 || (r > 0 && sched <= b * r + 1e-6)) return { rows, totalInterest: Infinity, payoff: Infinity, valid: false, scheduled: sched };
    let tot = 0;
    for (let m = 1; m <= MAX && b > 0.005; m++) {
      const o = b, i = o * r, paid = Math.min(sched, o + i);
      b = Math.max(0, o - Math.max(0, paid - i));
      tot += i;
      rows.push({ opening: o, paid, rate });
    }
    const ok = b <= 0.005;
    return { rows, totalInterest: ok ? tot : Infinity, payoff: ok ? rows.length : Infinity, valid: ok, scheduled: sched };
  }
  const months = (n: number) => (isFinite(n) ? `${n} months (${Math.round((n / 12) * 10) / 10} yrs)` : 'No payoff at entered payment');
  const yrsMo = (n: number) => {
    if (!isFinite(n)) return '—';
    const y = Math.floor(n / 12), m = n % 12, parts: string[] = [];
    if (y) parts.push(y + (y === 1 ? ' yr' : ' yrs'));
    if (m || !y) parts.push(m + (m === 1 ? ' mo' : ' mos'));
    return parts.join(' ');
  };

  function compute() {
    const v = state.v, debts = state.debts;
    const first: Acct = { byTerm: true, balance: v.mortgageBalance, rate: v.mortgageRate, months: v.mortgageMonths, secured: true };
    const accounts: Acct[] = [first, ...debts];
    const sims = accounts.map((a) => sim(a));
    const totalBalance = accounts.reduce((s, a) => s + num(a.balance), 0);
    const todayRate = totalBalance ? accounts.reduce((s, a) => s + num(a.balance) * num(a.rate), 0) / totalBalance : 0;
    let w = 0, o = 0;
    sims.forEach((sm) => sm.rows.forEach((row) => { w += row.opening * row.rate; o += row.opening; }));
    const currentProjectedRate = o ? w / o : 0;
    const newBalance = totalBalance + (state.finance ? num(v.closingCosts) : 0);
    const newLoan: Acct = { byTerm: true, balance: newBalance, rate: v.newRate, months: v.newMonths };
    const newSim = sim(newLoan);
    const currentInitial = sims.reduce((s, x) => s + x.scheduled, 0);
    const newInitial = newSim.scheduled;
    const curPay = (m: number) => sims.reduce((s, x) => s + (x.rows[m - 1]?.paid || 0), 0);
    const newPay = (m: number) => newSim.rows[m - 1]?.paid || 0;
    let current12 = 0, new12 = 0;
    for (let i = 1; i <= 12; i++) { current12 += curPay(i); new12 += newPay(i); }
    const hasBad = sims.some((x) => !x.valid);
    const currentInterest = hasBad ? Infinity : sims.reduce((s, x) => s + x.totalInterest, 0);
    const proposedInterest = newSim.totalInterest;
    const proposedInterestCosts = proposedInterest + num(v.closingCosts);
    const difference = proposedInterestCosts - currentInterest;
    const currentTimeline = Math.max(0, ...sims.map((x) => x.payoff));
    const securedNow = accounts.filter((a) => a.secured).reduce((s, a) => s + num(a.balance), 0);
    const hv = num(v.homeValue);
    const ltv = hv ? (newBalance / hv) * 100 : 0;
    const ltvLimit = num(v.ltvLimit);
    const y1 = new12 - current12;

    // extra principal
    const savings = Math.max(0, currentInitial - newInitial);
    const savingsRounded = Math.round(savings);
    const extraStr = state.extra === null ? String(savingsRounded) : state.extra;
    const extra = num(extraStr);
    const xSim = sim(newLoan, extra);
    const xInterestCosts = xSim.totalInterest + num(v.closingCosts);
    const xVs = xInterestCosts - currentInterest;
    const monthsSaved = newSim.valid && xSim.valid ? newSim.payoff - xSim.payoff : 0;

    // validation
    const errors: string[] = [];
    const errHome = hv <= 0 ? 'Enter a home value greater than $0.' : '';
    const errBalance = hv > 0 && num(v.mortgageBalance) > hv * 2 ? 'That balance looks high for this home value. Please double-check it.' : '';
    if (errHome) errors.push(errHome);
    if (num(v.mortgageRate) > 50 || num(v.newRate) > 50) errors.push('Use an interest rate from 0% to 50%.');
    if (num(v.mortgageMonths) < 1 || num(v.newMonths) < 1 || num(v.mortgageMonths) > MAX || num(v.newMonths) > MAX) errors.push('Use 1 to 600 months for months remaining and loan term.');
    if (v.newRate === '') errors.push('Enter a new mortgage rate.');

    const tone = (known: boolean, up: boolean) => (!known ? 'unknown' : up ? 'up' : 'down');
    const out: Record<string, string> = {
      todayRate: pct(todayRate),
      currentProjectedRate: pct(currentProjectedRate),
      newRate: pct(num(v.newRate)),
      totalBalance: money(totalBalance),
      mortgagePmt: money(pmt(num(v.mortgageBalance), num(v.mortgageRate), Math.floor(num(v.mortgageMonths)))),
      newBalance: money(newBalance),
      currentInitial: money(currentInitial),
      newInitial: money(newInitial),
      monthlyChange: money(Math.abs(currentInitial - newInitial)),
      monthlyChangeWord: newInitial <= currentInitial ? 'Lower to start with one new payment' : 'Higher to start with one new payment',
      current12: money(current12), new12: money(new12),
      year1Note: y1 <= 0 ? `About ${money(-y1)} less in year one` : `About ${money(y1)} more in year one`,
      current13: money(curPay(13)), new13: money(newPay(13)),
      current61: money(curPay(61)), new61: money(newPay(61)),
      currentInterest: hasBad ? 'Fix the flagged account' : money(currentInterest),
      proposedInterest: money(proposedInterest),
      proposedInterestCosts: money(proposedInterestCosts),
      diffText: !isFinite(difference) ? 'Fix the flagged account above to compare totals' : difference > 0 ? `Costs ${money(difference)} more overall` : `Saves ${money(-difference)} overall`,
      currentTimeline: months(currentTimeline),
      newTimeline: newSim.valid ? months(newSim.payoff) : '—',
      upfront: money(state.finance ? 0 : num(v.closingCosts)),
      equityNow: money(hv - securedNow),
      equityAfter: money(hv - newBalance),
      ltv: pct(ltv),
      ltvText: ltv > ltvLimit ? `Above your ${ltvLimit}% planning limit` : `Within your ${ltvLimit}% planning limit`,
      savingsLabel: money(savingsRounded) + '/mo',
      extraPay: money(extra),
      totalPay: money(newInitial + extra),
      payoffYears: xSim.valid ? yrsMo(xSim.payoff) : '—',
      timeSaved: monthsSaved > 0 ? `${yrsMo(monthsSaved)} sooner than ${yrsMo(newSim.payoff)}` : `Same as the regular ${yrsMo(newSim.payoff)}`,
      xInterest: money(xSim.totalInterest),
      interestSaved: money(Math.max(0, proposedInterest - xSim.totalInterest)),
      xInterestCosts: money(xInterestCosts),
      vsText: !isFinite(xVs) ? 'Fix the flagged account above' : xVs > 0 ? `Costs ${money(xVs)} more` : `Saves ${money(-xVs)}`,
      errHome, errBalance,
    };
    const show: Record<string, boolean> = {
      errHome: !!errHome, errBalance: !!errBalance,
      noDebts: debts.length === 0, invalid: errors.length > 0, valid: errors.length === 0, noSavings: savings <= 0,
    };
    const tones: Record<string, string> = {
      diff: tone(isFinite(difference), difference > 0),
      vs: tone(isFinite(xVs), xVs > 0),
      ltv: ltv > ltvLimit ? 'up' : 'down',
    };
    const notes = debts.map((d) => {
      const sm = sim(d);
      let text: string;
      if (num(d.balance) <= 0) text = 'Enter the balance owed to include this account.';
      else if (num(d.payment) <= 0) text = 'Enter the monthly payment from your statement.';
      else if (sm.valid && d.type === 'installment') text = `Paid off in about ${sm.payoff} months at this payment.`;
      else if (sm.valid) text = `Paid off in about ${sm.payoff} months, if no new charges are added.`;
      else text = 'This payment doesn’t cover the interest, so it never pays off. Raise the payment to see your full totals.';
      return { text, ok: sm.valid };
    });
    return { out, show, tones, errors, notes, extraStr };
  }

  const root = document.querySelector('.rr') as HTMLElement;
  const debtsEl = document.getElementById('rr-debts') as HTMLElement;
  const errEl = document.getElementById('rr-errors') as HTMLElement;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

  function renderDebts() {
    debtsEl.innerHTML = state.debts.map((d, i) => `
      <div class="rr-debt" data-id="${d.id}">
        <div class="rr-debt-top">
          <strong>Account ${i + 1}</strong>
          <button type="button" class="rr-del" data-action="remove" aria-label="Remove account ${i + 1}">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg>
          </button>
        </div>
        <div class="rr-debt-grid">
          <label class="rr-lbl">Account name<span class="rr-in"><input class="rr-fld" type="text" data-dk="name" value="${esc(d.name)}"></span></label>
          <div class="rr-lbl"><span>Account type</span>
            <div class="rr-seg" role="group" aria-label="Account type">
              <button type="button" class="rr-pill" data-action="type" data-type="installment" aria-pressed="${d.type === 'installment'}">Installment</button>
              <button type="button" class="rr-pill" data-action="type" data-type="revolving" aria-pressed="${d.type === 'revolving'}">Revolving</button>
            </div>
          </div>
          <label class="rr-lbl">Balance owed<span class="rr-in"><input class="rr-fld" type="number" inputmode="decimal" min="0" data-dk="balance" value="${esc(d.balance)}"><span class="rr-sfx">$</span></span></label>
          <label class="rr-lbl">Interest rate<span class="rr-in"><input class="rr-fld" type="number" inputmode="decimal" min="0" max="50" step="0.01" data-dk="rate" value="${esc(d.rate)}"><span class="rr-sfx">%</span></span></label>
          <label class="rr-lbl">Monthly payment<span class="rr-in"><input class="rr-fld" type="number" inputmode="decimal" min="0" data-dk="payment" value="${esc(d.payment)}"><span class="rr-sfx">$</span></span></label>
          <div class="rr-sec-row"><span>Secured by this home?</span>
            <button type="button" class="rr-sw" role="switch" aria-checked="${d.secured}" aria-label="Account ${i + 1} secured by this home" data-action="secured"><span class="rr-trk"><span class="rr-knob"></span></span></button>
          </div>
        </div>
        <p class="rr-dnote" data-note="${i}"></p>
      </div>`).join('');
  }

  function syncInputs() {
    root.querySelectorAll<HTMLInputElement>('[data-field]').forEach((el) => {
      const k = el.dataset.field as string;
      if (k !== 'extra') el.value = state.v[k] ?? '';
    });
  }

  function update() {
    const c = compute();
    root.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => { el.textContent = c.out[el.dataset.out as string] ?? ''; });
    root.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => { el.hidden = !c.show[el.dataset.show as string]; });
    root.querySelectorAll<HTMLElement>('[data-tone]').forEach((el) => {
      el.classList.remove('rr-tone-up', 'rr-tone-down', 'rr-tone-unknown');
      el.classList.add('rr-tone-' + c.tones[el.dataset.tone as string]);
    });
    errEl.innerHTML = c.errors.map((e) => `<li>${esc(e)}</li>`).join('');
    c.notes.forEach((n, i) => {
      const el = debtsEl.querySelector<HTMLElement>(`[data-note="${i}"]`);
      if (el) { el.textContent = n.text; el.classList.toggle('rr-bad', !n.ok); }
    });
    const extraEl = root.querySelector<HTMLInputElement>('[data-field="extra"]');
    if (extraEl && document.activeElement !== extraEl) extraEl.value = c.extraStr;
    const fin = root.querySelector('[data-action="finance"]');
    fin?.setAttribute('aria-checked', String(state.finance));
  }

  root.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.field) {
      if (t.dataset.field === 'extra') state.extra = t.value;
      else state.v[t.dataset.field] = t.value;
    } else if (t.dataset.dk) {
      const id = Number(t.closest<HTMLElement>('.rr-debt')?.dataset.id);
      const d = state.debts.find((x) => x.id === id);
      if (d) (d as Record<string, unknown>)[t.dataset.dk] = t.value;
    }
    update();
  });

  root.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
    if (!btn) return;
    const action = btn.dataset.action;
    const card = btn.closest<HTMLElement>('.rr-debt');
    const d = card ? state.debts.find((x) => x.id === Number(card.dataset.id)) : undefined;
    switch (action) {
      case 'reset': state.v = defaults(); state.finance = true; state.debts = exampleDebts(); state.extra = null; syncInputs(); renderDebts(); break;
      case 'clear': state.v = blank(); state.finance = true; state.debts = []; state.extra = null; syncInputs(); renderDebts(); break;
      case 'finance': state.finance = !state.finance; break;
      case 'add': state.debts.push({ id: Date.now(), name: 'New account', type: 'installment', balance: '', rate: '', payment: '', secured: false }); renderDebts(); break;
      case 'remove': state.debts = state.debts.filter((x) => x !== d); renderDebts(); break;
      case 'type': if (d) { d.type = btn.dataset.type as Debt['type']; renderDebts(); } break;
      case 'secured': if (d) { d.secured = !d.secured; renderDebts(); } break;
      case 'useSavings': state.extra = null; break;
      case 'useZero': state.extra = '0'; break;
      default: return;
    }
    update();
  });

  syncInputs();
  renderDebts();
  update();
</script>
