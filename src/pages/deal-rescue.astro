---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Deal Rescue">
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-5xl font-bold text-center mb-8 text-primary-magenta">Been Declined? I Specialize in Deal Rescue</h1>
      <p class="text-xl text-center text-gray-600 mb-12">Other lenders say no. I find a way to yes.</p>
      
      <div class="bg-gray-50 p-8 rounded-xl mb-12">
        <h2 class="text-2xl font-bold mb-6">Common Situations I Fix:</h2>
        <ul class="space-y-3">
          <li class="flex items-start"><span class="text-primary-cyan text-2xl mr-3">✓</span> <span>Credit challenges or past bankruptcies</span></li>
          <li class="flex items-start"><span class="text-primary-cyan text-2xl mr-3">✓</span> <span>Self-employed income complications</span></li>
          <li class="flex items-start"><span class="text-primary-cyan text-2xl mr-3">✓</span> <span>High debt-to-income ratios</span></li>
          <li class="flex items-start"><span class="text-primary-cyan text-2xl mr-3">✓</span> <span>Deals falling apart at the last minute</span></li>
          <li class="flex items-start"><span class="text-primary-cyan text-2xl mr-3">✓</span> <span>Appraisal or inspection issues</span></li>
          <li class="flex items-start"><span class="text-primary-cyan text-2xl mr-3">✓</span> <span>Limited savings for down payment</span></li>
        </ul>
      </div>

      <div class="text-center">
        <h2 class="text-3xl font-bold mb-6">How It Works</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          <div class="bg-white p-6 rounded-xl shadow-md">
            <div class="text-4xl font-bold text-primary-magenta mb-2">1</div>
            <h3 class="font-bold mb-2">Quick Review</h3>
            <p class="text-gray-600">I review your situation and identify the roadblocks</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md">
            <div class="text-4xl font-bold text-primary-cyan mb-2">2</div>
            <h3 class="font-bold mb-2">Creative Solutions</h3>
            <p class="text-gray-600">I restructure your application to work within guidelines</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md">
            <div class="text-4xl font-bold text-primary-magenta mb-2">3</div>
            <h3 class="font-bold mb-2">Get Approved</h3>
            <p class="text-gray-600">We get you to closing, often faster than expected</p>
          </div>
        </div>

        <a href="https://calendly.com/dennisfieldsmortgagepro" target="_blank" class="inline-block bg-primary-magenta text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-pink-600 transition-all shadow-lg">
          Get Your Deal Rescued Now
        </a>
      </div>
    </div>
  </section>
</Layout>
