---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resources">
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-5xl font-bold text-center mb-8">Homebuyer Resources</h1>
      <p class="text-xl text-center text-gray-600 mb-12">Educational content to help you make informed decisions.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-8 rounded-xl shadow-md">
          <h2 class="text-2xl font-bold mb-4 text-primary-magenta">Calculators & Tools</h2>
          <ul class="space-y-3 text-gray-700">
            <li><a href="https://www.mortgagecalculator.org/" target="_blank" class="hover:text-primary-cyan">Mortgage Calculator</a></li>
            <li><a href="https://www.zillow.com/mortgage-calculator/house-affordability/" target="_blank" class="hover:text-primary-cyan">Affordability Calculator</a></li>
            <li><a href="https://www.bankrate.com/mortgages/mortgage-closing-costs-calculator/" target="_blank" class="hover:text-primary-cyan">Closing Costs Estimator</a></li>
            <li><a href="https://www.bankrate.com/mortgages/refinance-calculator/" target="_blank" class="hover:text-primary-cyan">Refinance Calculator</a></li>
          </ul>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-md">
          <h2 class="text-2xl font-bold mb-4 text-primary-cyan">Educational Guides</h2>
          <ul class="space-y-3 text-gray-700">
            <li><a href="/first-time-buyers" class="hover:text-primary-magenta">First-Time Buyer Guide</a></li>
            <li><a href="https://www.myfico.com/credit-education/improve-your-credit-score" target="_blank" class="hover:text-primary-magenta">Credit Score Improvement Guide</a></li>
            <li><a href="https://www.va.gov/housing-assistance/home-loans/" target="_blank" class="hover:text-primary-magenta">VA Loan Benefits</a></li>
            <li><a href="/loan-programs#dpa" class="hover:text-primary-magenta">Down Payment Assistance Programs</a></li>
          </ul>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-md">
          <h2 class="text-2xl font-bold mb-4 text-primary-magenta">Market Updates</h2>
          <ul class="space-y-3 text-gray-700">
            <li><a href="https://www.mortgagenewsdaily.com/mortgage-rates" target="_blank" class="hover:text-primary-cyan">Current Interest Rates</a></li>
            <li><a href="https://www.zillow.com/home-values/" target="_blank" class="hover:text-primary-cyan">Market Trends</a></li>
            <li><a href="https://www.housingwire.com/" target="_blank" class="hover:text-primary-cyan">Housing News</a></li>
          </ul>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-md">
          <h2 class="text-2xl font-bold mb-4 text-primary-cyan">Frequently Asked Questions</h2>
          <ul class="space-y-3 text-gray-700">
            <li><a href="/loan-programs#fha" class="hover:text-primary-magenta">How much do I need for a down payment?</a></li>
            <li><a href="/deal-rescue" class="hover:text-primary-magenta">What credit score do I need?</a></li>
            <li><a href="/first-time-buyers" class="hover:text-primary-magenta">How long does it take to close?</a></li>
            <li><a href="/deal-rescue" class="hover:text-primary-magenta">Can I buy with bad credit?</a></li>
          </ul>
        </div>
      </div>

      <div class="mt-16 bg-gradient-to-br from-primary-cyan to-blue-600 text-white rounded-2xl p-12 text-center">
        <h2 class="text-3xl font-bold mb-4">Still Have Questions?</h2>
        <p class="text-xl mb-8">Schedule a free consultation and I'll answer them all.</p>
        <a href="https://www.dennisfieldsmortgagepro.com" target="_blank" class="inline-block bg-white text-primary-cyan px-8 py-4 rounded-lg font-bold text-lg hover:bg-gray-100 transition-all">
          Talk to Dennis
        </a>
      </div>
    </div>
  </section>
</Layout>
